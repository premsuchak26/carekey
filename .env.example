# ==============================================================================
# CareKey - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust the values for your environment.
# In production, configure these via Cloud Run Environment Variables or Secret Manager.
# NEVER commit production secrets or real passwords to version control.

# --- Core Application Settings ---
APP_NAME=CareKey
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8080

# --- Security & Cryptographic Secrets ---
# In production (ENVIRONMENT=production), the app REFUSES to start if SECRET_KEY
# or TICK_SECRET is missing or using default values.
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
TICK_SECRET=change-this-to-a-secure-tick-secret-in-production

# Base URL used for constructing signed one-tap email action links
APP_BASE_URL=http://localhost:8080

# --- Persistence Backend Configuration ---
# 'memory' for local dev and automated tests, 'firestore' for Cloud Run production
REPOSITORY_BACKEND=memory

# Google Cloud Firestore Configuration (when REPOSITORY_BACKEND=firestore)
# On Cloud Run, default credentials and GOOGLE_CLOUD_PROJECT are discovered automatically.
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Outbound Email Relay Settings (SMTP) ---
# Used by ReminderService for dose ladders, caretaker escalation, and appointment alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=reminders@carekey.local
SMTP_USE_TLS=true
