# CareKey Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control.

# Application Settings
APP_NAME=CareKey
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Repository Backend: 'memory' for local dev/testing, 'firestore' for production
REPOSITORY_BACKEND=memory

# Google Cloud Firestore Configuration (required when REPOSITORY_BACKEND=firestore)
# FIRESTORE_PROJECT_ID=carekey-hackathon
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
